#!/usr/bin/env bash
# ============================================================================
# ligactl — Основной CLI-оркестратор Ligament Vault
# ============================================================================
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
    LINK_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${LINK_DIR}/${SOURCE}"
done
DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
export CLI_INVOKED_AS="ligactl"
exec "${DIR}/clusterctl" "$@"
