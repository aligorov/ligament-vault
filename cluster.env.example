# ============================================================================
# cluster.env — Топология и параметры развертывания Ligament Vault
# ============================================================================
# Скопируйте: cp cluster.env.example cluster.env && chmod 600 cluster.env
# Сгенерируйте секреты: ./ligactl secrets init
# Проверьте готовность: ./ligactl preflight
# ============================================================================

# --- Идентификация проекта и контура ---
PROJECT_NAME="Ligament Vault"
CLUSTER_SLUG="ligament-vault"        # Scope для /opt/<slug>, etcd /<slug>/, Patroni, pgBackRest

# --- Узлы кластера (минимум 3) ---
# Формат: "IP:DC_NAME:HOSTNAME" через пробел
CLUSTER_NODES="FIXME_IP1:dc1:node1 FIXME_IP2:dc2:node2 FIXME_IP3:dc3:node3"

# --- Домен, ACME, DNS и Быстрый Failover ---
DOMAIN="files.company.com"
ACME_EMAIL="admin@company.com"
DNS_PROVIDER="cloudflare"            # cloudflare | route53 | hetzner | ...
CLOUDFLARE_ZONE_ID=""                # Опционально (или определится автоматически по DOMAIN)
DNS_TTL=60                           # TTL A-записи в секундах (рекомендуется 30–60s)
DNS_UPDATE_HOOK=""                   # Опц. скрипт смены A-записи для провайдера != cloudflare

FAILOVER_MODE="dns"                  # dns | floating-ip | hybrid (Floating IP дает RTO ~10-15s)
FLOATING_IP_PROVIDER=""              # hetzner | digitalocean | custom
FLOATING_IP_ID=""                    # ID Floating/Reserved IP в облачном провайдере
FLOATING_IP_HOOK=""                  # Кастомный скрипт переключения VIP: hook <NEW_IP>

# --- Сеть, Веб-панель управления и безопасность ---
PANEL_PORT=8443                      # HTTPS порт единой веб-панели управления Ligament Vault
ADMIN_SSH_NET="0.0.0.0/0"            # IP/CIDR администратора для SSH и веб-панели :8443
ADMIN_SSH_PORT=22                    # Порт SSH хоста (22 или 2222)
SFTP_PORT=2022                       # Порт SFTPGo SFTP
FTPS_PORT=21                         # Порт SFTPGo FTPS
FTPS_PASV_MIN=50000                  # Начало PASV-диапазона
FTPS_PASV_MAX=50199                  # Конец PASV-диапазона

# --- SFTPGo, WORM и интеграция с Ligament 2FA ---
# ⚠️ ВАЖНО для WORM: при обслуживании sftp-worm на общем инстансе SFTPGo
# обязательно upload_mode=1 (удаление temp при обрыве), см. PLAN.md §4.2.
SFTPGO_UPLOAD_MODE=1
SFTPGO_ADMIN_USERNAME="admin"        # Начальный администратор SFTPGo WebAdmin/API
SFTPGO_TELEMETRY_PORT=10000          # Порт /metrics SFTPGo (закрыт в UFW для всех кроме ARBITER_IP)
WORM_RETENTION_MODE="COMPLIANCE"     # COMPLIANCE или GOVERNANCE для DefaultRetention на sftp-worm
WORM_RETENTION_DAYS=365              # Срок удержания объектов в sftp-worm по умолчанию (дней)

LIGAMENT_2FA_ENABLED="false"         # true — включить pre_login_hook проверку в Ligament 2FA
LIGAMENT_2FA_API_URL="https://2fa.company.com"
LIGAMENT_2FA_TIMEOUT_SEC=5           # Таймаут запроса к Ligament 2FA (сек)
LIGAMENT_2FA_FAIL_OPEN="false"       # false = fail-closed (блокировать вход при недоступности 2FA)

# --- Пороги preflight и WAN-тайминги ---
RTT_WARN=150                         # Предупреждение при RTT > 150ms
RTT_HARD_STOP=250                    # Hard stop: preflight блокирует при RTT > 250ms
MIN_FREE_DISK_GB=80                  # Минимум свободного места на разделе данных (>=80GB под 64GB pg_wal)
ETCD_HEARTBEAT_INTERVAL=250          # мс (по формуле election >= 10 * max_RTT)
ETCD_ELECTION_TIMEOUT=2500           # мс

# --- Пути хранения на хостах (прямые bind-mounts на раздел /data, а не в /var/lib/docker!) ---
SFTPGO_TEMP_PATH="/data/sftpgo-temp" # Локальный temp_path буферизации загрузок (NVMe)
SFTPGO_DATA_DIR="/data/sftpgo"       # Домашние каталоги и служебные данные SFTPGo (UID 1000)
SWFS_VOLUME_DIR="/data/seaweedfs"    # Директории томов SeaweedFS (через запятую при expand-disk)
SWFS_MASTER_DIR="/data/swfs-master"  # Raft-логи и метаданные SeaweedFS Master
PG_DATA_DIR="/data/postgresql"       # Директория данных и WAL PostgreSQL
ETCD_DATA_DIR="/data/etcd"           # Директория Raft WAL/snapshots etcd

# --- SeaweedFS ---
SWFS_DEFAULT_REPLICATION="100"       # 2 копии в разных ДЦ
SWFS_VOLUME_GROWTH_COUNT=2           # volumeGrowthCount (кратно репликации)
SWFS_MASTER_PORT=9333
SWFS_VOLUME_PORT=8082
SWFS_FILER_PORT=8888
SWFS_S3_PORT=8333
SWFS_ADMIN_PORT=12535
SWFS_ADMIN_GRPC_PORT=22535
SWFS_ADMIN_NODE_INDEX=2              # На каком узле работает weed admin (по умолчанию node2)
SWFS_MASTER_METRICS_PORT=9324
SWFS_VOLUME_METRICS_PORT=9325
SWFS_FILER_METRICS_PORT=9326

# --- Patroni / PostgreSQL ---
PG_PORT=5432
PATRONI_API_PORT=8008
HAPROXY_PG_PORT=5433                 # Локальный HAProxy -> PG Primary

# --- etcd ---
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380
ETCD_METRICS_PORT=2381               # HTTP /metrics только для IP Арбитра в UFW

# --- Арбитр (внешний мониторинг и DNS/VIP failover) ---
ARBITER_IP=""                        # IP внешней VPS с Prometheus+Alertmanager и dns-failover-arbiter
ARBITER_SSH_KEY=""                   # Опц. путь к ключу для доступа оператора к Арбитру
ALERT_WEBHOOK_URL="http://127.0.0.1:9099/alerts"  # URL webhook для Alertmanager

# --- Масштабирование ---
MAX_ETCD_VOTERS=5                    # Максимум etcd-голосующих (всегда нечетное: 3 или 5)
VOLUME_BALANCE_AFTER_ADD=true        # Автоматический volume.balance + fix.replication после scale add
