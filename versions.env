# ============================================================================
# versions.env — Зафиксированные версии образов Ligament Vault
# ============================================================================
# Все внешние образы рекомендуется пинить по @sha256 дайджесту:
#   ./ligactl pin-versions
# Откат: ./ligactl rollback восстанавливает дайджесты из .rollback_state
# ============================================================================

# --- SFTPGo (компактный образ Alpine ~65MB со встроенным S3 и PostgreSQL) ---
SFTPGO_IMAGE="drakkan/sftpgo:v2.7-alpine"
SFTPGO_DIGEST="sha256:FIXME_REPLACE_WITH_ACTUAL_DIGEST"

# --- SeaweedFS 4.x ---
SEAWEEDFS_IMAGE="chrislusf/seaweedfs:4.55"
SEAWEEDFS_DIGEST="sha256:FIXME_REPLACE_WITH_ACTUAL_DIGEST"

# --- PostgreSQL 16 + Patroni + pgBackRest (Docker Hub + локальный fallback из Dockerfile.patroni) ---
DOCKERHUB_PATRONI_REPO="aligorov/ligament_vault_patroni"
PATRONI_PG_IMAGE="aligorov/ligament_vault_patroni:16"
PATRONI_PG_DIGEST=""

# --- etcd v3.5 ---
ETCD_IMAGE="quay.io/coreos/etcd:v3.5.17"
ETCD_DIGEST="sha256:FIXME_REPLACE_WITH_ACTUAL_DIGEST"

# --- HAProxy ---
HAPROXY_IMAGE="haproxy:3.0-alpine"
HAPROXY_DIGEST="sha256:FIXME_REPLACE_WITH_ACTUAL_DIGEST"

# --- lego (ACME DNS-01) ---
LEGO_IMAGE="goacme/lego:v4.21.0"
LEGO_DIGEST="sha256:FIXME_REPLACE_WITH_ACTUAL_DIGEST"

# --- Prometheus (Арбитр) ---
PROMETHEUS_IMAGE="prom/prometheus:v2.55.1"
PROMETHEUS_DIGEST="sha256:FIXME_REPLACE_WITH_ACTUAL_DIGEST"

# --- Alertmanager (Арбитр) ---
ALERTMANAGER_IMAGE="prom/alertmanager:v0.28.1"
ALERTMANAGER_DIGEST="sha256:FIXME_REPLACE_WITH_ACTUAL_DIGEST"

# --- node_exporter ---
NODE_EXPORTER_IMAGE="prom/node-exporter:v1.8.2"
NODE_EXPORTER_DIGEST="sha256:FIXME_REPLACE_WITH_ACTUAL_DIGEST"

# --- blackbox_exporter (Арбитр, проверка SSL expiry) ---
BLACKBOX_EXPORTER_IMAGE="prom/blackbox-exporter:v0.25.0"
BLACKBOX_EXPORTER_DIGEST="sha256:FIXME_REPLACE_WITH_ACTUAL_DIGEST"
