# ============================================================================
# secrets.env — Секреты кластера Ligament Vault
# ============================================================================
# Рекомендуемый способ (Zero-Plaintext в RAM через age):
#   ./ligactl secrets init        # сгенерирует все ключи и создаст secrets.env.age
#   ./ligactl secrets edit        # безопасное редактирование в памяти
#
# Ручной способ без age:
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
# ============================================================================

# --- KMS и токены SFTPGo / Веб-панель ---
PANEL_ADMIN_PASSWORD="FIXME_GENERATE"                     # Отдельный пароль администратора Веб-панели (:9443)
SFTPGO_ADMIN_PASSWORD="FIXME_GENERATE"                    # Пароль админа SFTPGo WebAdmin/REST API (127.0.0.1:8081)
SFTPGO_KMS_MASTER_KEY="FIXME_GENERATE_32_BYTE_HEX"       # openssl rand -hex 32
SFTPGO_SIGNING_PASSPHRASE="FIXME_GENERATE_PASSPHRASE"     # 32+ символа
SFTPGO_INSTALLATION_CODE="FIXME_UNIQUE_CODE"              # openssl rand -hex 16

# --- Интеграция с Ligament 2FA (при LIGAMENT_2FA_ENABLED=true) ---
LIGAMENT_2FA_API_TOKEN=""                                 # Bearer-токен сервиса Ligament 2FA

# --- PostgreSQL / Patroni ---
PG_SUPERUSER_PASSWORD="FIXME_GENERATE"                    # DSN-безопасный пароль postgres
PG_REPLICATION_PASSWORD="FIXME_GENERATE"                  # DSN-безопасный пароль replicator
PATRONI_API_PASSWORD="FIXME_GENERATE"                     # Пароль мутирующих запросов Patroni REST API (:8008)
SFTPGO_DB_PASSWORD="FIXME_GENERATE"                       # Пароль пользователя sftpgo в PG
SWFS_FILER_DB_PASSWORD="FIXME_GENERATE"                   # Пароль пользователя seaweedfs в PG

# --- SeaweedFS JWT (4 обязательных ключа) ---
SWFS_JWT_SIGNING_KEY="FIXME_GENERATE"                     # Ключ подписи записи Volume
SWFS_JWT_SIGNING_READ_KEY="FIXME_GENERATE"                # Ключ подписи чтения Volume
SWFS_JWT_FILER_SIGNING_KEY="FIXME_GENERATE"               # Ключ подписи записи Filer
SWFS_JWT_FILER_SIGNING_READ_KEY="FIXME_GENERATE"          # Ключ подписи чтения Filer

# --- SeaweedFS Admin & S3 IAM ---
SWFS_ADMIN_PASSWORD="FIXME_GENERATE"                      # Пароль weed admin UI (HTTPS :12535)
SWFS_S3_SECRET_KEY_SFTPGO="FIXME_GENERATE"                # Secret key для sftpgo-s3-access в s3.json
SWFS_S3_SECRET_KEY_BACKUP="FIXME_GENERATE"                # Secret key для backup-s3-access в s3.json

# --- etcd ---
ETCD_ROOT_PASSWORD="FIXME_GENERATE"                       # Пароль root в etcd

# --- DNS API и Floating IP (для lego DNS-01 и арбитра failover) ---
CF_DNS_API_TOKEN="FIXME_CLOUDFLARE_API_TOKEN"
HETZNER_CLOUD_TOKEN=""                                    # Опц. для FAILOVER_MODE=floating-ip|hybrid (hetzner)
DO_API_TOKEN=""                                           # Опц. для FAILOVER_MODE=floating-ip|hybrid (digitalocean)

# --- Бэкапы (внешний S3 для pgBackRest и weed filer.backup) ---
BACKUP_S3_ENDPOINT="https://s3.backup-provider.com"
BACKUP_S3_REGION="us-east-1"
BACKUP_S3_ACCESS_KEY="FIXME"
BACKUP_S3_SECRET_KEY="FIXME"
BACKUP_S3_BUCKET="ligament-vault-backups"
BACKUP_ENCRYPTION_KEY="FIXME_GENERATE_32_BYTE_HEX"       # Ключ клиентского AES-256 шифрования бэкапов

# --- PKI ---
CA_KEY_PASSPHRASE="FIXME_CA_PASSPHRASE"                   # Пароль защиты Root CA
